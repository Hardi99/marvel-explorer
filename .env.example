# Base PostgreSQL (Neon en production)
DATABASE_URL=postgres://user:password@host/db
# Secret de signature des sessions (JWT) : 32+ caractères aléatoires
JWT_SECRET=
# Clé de l'API Marvel (lereacteur-marvel-api)
MARVEL_API_KEY=
# Envoi des e-mails (bienvenue, réinitialisation)
RESEND_API_KEY=
# TMDB (themoviedb.org › Paramètres › API) : « clé d'API » ou « jeton de lecture ». Facultatif.
TMDB_TOKEN=
# Adresse publique du site (liens dans les e-mails, sitemap)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
